{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wafy",
  "version": "1.0.0",
  "identifier": "io.github.wafy.Wafy",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Ultra-lightweight desktop messaging client for Linux",
    "longDescription": "Wafy is an ultra-lightweight, high-performance desktop messaging client for Linux designed for seamless communication with minimal system resource usage.",
    "linux": {
      "deb": {
        "desktopTemplate": "../assets/wafy.desktop",
        "preInstallScript": "../scripts/preinstall.sh"
      }
    }
  }
}
